/gamebin/
/mc4data/
/extracted/
# Runtime, logs
/ctl/
/logs/
/scratch/
/release/
# Build outputs
/qemu/obj-*/
/qemu/out/
/qemu/orig/
/qemu/*.log
/qemu/.build_variant_lf.sh
__pycache__/
*.apk
*.idsig
release.pass
